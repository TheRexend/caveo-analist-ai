# === Caveo Dashboard — variáveis de ambiente ===
# Em desenvolvimento local, estas variáveis são lidas automaticamente do
# ../.mcp.json (e do arquivo GOOGLE_APPLICATION_CREDENTIALS) — não precisa
# preencher nada localmente. Na Vercel, configure cada uma em
# Project Settings → Environment Variables.

# ── Meta Ads (Graph API) ─────────────────────────────────────────────────
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_438086148409254

# ── Google Ads (REST API) ────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=5029399396
GOOGLE_ADS_TARGET_CUSTOMER_ID=3921127876
GOOGLE_ADS_API_VERSION=v21
# Credenciais authorized_user (na Vercel não há arquivo de creds — use estas):
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# ── Salesforce (SOQL REST) ───────────────────────────────────────────────
SF_INSTANCE_URL=https://caveo.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REFRESH_TOKEN=
SF_ACCESS_TOKEN=

# ── Metas (storage) ──────────────────────────────────────────────────────
# Local: deixe vazio → usa SQLite em data/goals.db
# Vercel: defina a connection string Postgres (Supabase/Neon/Vercel Postgres)
POSTGRES_URL=
