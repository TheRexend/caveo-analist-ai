# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local sqlite (metas) — em prod usa Postgres
/data/*.db

# MCPs locais — venv, cache e credenciais nunca vão ao git
mcps/.venv/
mcps/**/__pycache__/
mcps/**/credentials.json
mcps/**/token.json
mcps/*_credentials.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# === Caveo — versiona a camada agêntica; NUNCA versiona segredos ===
# Segredos / credenciais (mesmo dentro de pastas versionadas):
.mcp.json
.mcp.json.bak
**/*credentials*.json
**/*credential*.json
**/token.json
.claude/settings.local.json

# Cruft de workspace e dependências vendorizadas (não vale versionar):
/dashboard/
outputs/
scratch/
.agents/
.codex/
.superpowers/
skills-lock.json
package-lock.json

# Versionados a partir de agora (antes ignorados): docs/, scripts/, config/,
# mcps/ (só código), .claude/ (agentes/skills/comandos), CLAUDE.md, AGENTS.md.

# Worktrees isolados (criados pelo EnterWorktree / git worktree add):
.claude/worktrees/
